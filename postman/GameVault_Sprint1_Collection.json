{
	"info": {
		"_postman_id": "a9b8c7d6-e5f4-4321-ba98-76543210fedc",
		"name": "GameVault - Sprint 1 REST API Tests",
		"description": "Simple Postman test collection for GameVault Sprint 1. Verifies that endpoints return expected data and proper HTTP status/error codes.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET /api/library - Get all games",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Returns list of games\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data).to.be.an('array');",
							"    pm.expect(data.length).to.be.greaterThan(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/library",
					"host": ["{{baseUrl}}"],
					"path": ["api", "library"]
				},
				"description": "Retrieves the game library list."
			}
		},
		{
			"name": "GET /api/library/1 - Get game by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Returns expected game data (Hades)\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data.id).to.eql(1);",
							"    pm.expect(data.title).to.eql(\"Hades\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/library/1",
					"host": ["{{baseUrl}}"],
					"path": ["api", "library", "1"]
				},
				"description": "Retrieves a single game by ID."
			}
		},
		{
			"name": "GET /api/library/999 - Non-existent game (404)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 404 Not Found\", function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/library/999",
					"host": ["{{baseUrl}}"],
					"path": ["api", "library", "999"]
				},
				"description": "Verifies 404 error code when requesting an ID that does not exist."
			}
		},
		{
			"name": "POST /api/library - Add game (201)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Returns created game with ID\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data.title).to.eql(\"Celeste\");",
							"    pm.expect(data.status).to.eql(\"PLAYING\");",
							"    pm.expect(data.id).to.be.a('number');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Celeste\",\n    \"status\": \"PLAYING\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/library",
					"host": ["{{baseUrl}}"],
					"path": ["api", "library"]
				},
				"description": "Adds a new game to the library."
			}
		},
		{
			"name": "POST /api/library - Validation error (400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"\",\n    \"status\": \"BACKLOG\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/library",
					"host": ["{{baseUrl}}"],
					"path": ["api", "library"]
				},
				"description": "Verifies 400 Bad Request error code when sending a blank title."
			}
		}
	]
}
