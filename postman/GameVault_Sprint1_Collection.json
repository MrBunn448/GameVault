			}
		},
		{
			"name": "US-09: POST /api/library (Add Game -> 201 Created)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Location header is returned\", function () {",
							"    pm.response.to.have.header(\"Location\");",
							"});",
							"",
							"pm.test(\"Response body contains saved game with assigned ID\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData.title).to.eql(\"Celeste\");",
							"    pm.expect(jsonData.status).to.eql(\"PLAYING\");",
							"    pm.expect(jsonData.personalRating).to.eql(9);",
							"    pm.expect(jsonData.playtimeHours).to.eql(15);",
							"    ",
							"    // Store generated ID for subsequent DELETE test",
							"    pm.collectionVariables.set(\"createdGameId\", jsonData.id.toString());",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Celeste\",\n    \"status\": \"PLAYING\",\n    \"personalRating\": 9,\n    \"playtimeHours\": 15,\n    \"startDate\": \"2026-09-01\",\n    \"completedDate\": null\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/library",
					"host": ["{{baseUrl}}"],
					"path": ["api", "library"]
				},
				"description": "Creates a new library item with valid title, status, and metadata."
			}
		},
